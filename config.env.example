# pi-Mesh GUI runtime config — sourced by scripts/start-gui.sh.
# Copy to ``config.env`` and edit as needed. Every variable here matches
# a `config.py` getter; unknown keys are silently ignored.

# ---- Meshtastic radio ------------------------------------------------------
# Serial device of the LoRa board. The "Serial port" Config section writes
# back to this key when you pick a different port.
SERIAL_PATH=/dev/ttyACM0

# ---- Storage --------------------------------------------------------------
# SQLite path. The GUI factory-reset wipes this file (and its WAL/SHM
# siblings) on confirm.
DB_PATH=data/mesh.db

# ---- Logging --------------------------------------------------------------
# Standard Python log level: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=WARNING

# Seconds the node cache is considered fresh before the background loop
# re-pulls from the radio. Lower = snappier UI, more serial traffic.
NODE_CACHE_TTL=8.0

# ---- Map ------------------------------------------------------------------
# 1 = use local tiles under data/tiles/, 0 = fall back to network OSM.
MAP_LOCAL_TILES=0

# One of: italia, francia, germania, spagna, europa, mondo (see config.py
# REGION_BOUNDS for the bounding boxes used by the map page).
MAP_REGION=italia

# ---- Alerts thresholds ----------------------------------------------------
# How long a node can be silent before the status icon flags it offline.
ALERT_NODE_OFFLINE_MIN=30

# Battery percent that triggers the low-battery icon.
ALERT_BATTERY_LOW=20

# RAM percent that triggers the high-RAM warning in the metrics page.
ALERT_RAM_HIGH=85

# ---- MQTT bridge ----------------------------------------------------------
# Set to 1 to enable the bridge at startup. Broker address, credentials
# and topics are persisted in the DB via the Config → MQTT page.
MQTT_ENABLED=0
