[Unit]
Description=pi-Mesh native Qt GUI (framebuffer kiosk)
After=network.target meshtasticd.service
Wants=meshtasticd.service
Conflicts=kiosk.service

[Service]
User=root
WorkingDirectory=/home/pimesh/pi-mesh-gui
Environment=QT_QPA_PLATFORM=linuxfb:fb=/dev/fb1
Environment=QT_QPA_GENERIC_PLUGINS=evdevmouse,evdevkeyboard
Environment=HOME=/home/pimesh
Environment=PIMESH_GUI_EMBEDDED_UVICORN=0
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/python3 -m gui
Restart=always
RestartSec=5
# Cap memory: Pi has 1-4GB, 256M is generous for a Qt kiosk; catches leaks early.
MemoryMax=256M
OOMPolicy=kill
# Limit restart storms: max 5 restarts in 60s, then enter failed state.
StartLimitIntervalSec=60
StartLimitBurst=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
