[Unit]
Description=pi-Mesh native Qt GUI (framebuffer kiosk)
After=network.target meshtasticd.service
Wants=meshtasticd.service
Conflicts=kiosk.service

[Service]
User=root
WorkingDirectory=/home/pimesh/pi-mesh-gui
Environment=QT_QPA_PLATFORM=linuxfb:fb=/dev/fb1
# Input handling via libinput (single plugin, handles mouse + touch +
# keyboard). evdevtouch was unusable here because the ADS7846 kernel
# driver does not expose ABS_MT_POSITION_{X,Y} ranges, so mtdev
# reported min=max=0 and every tap was mapped to (0,0). libinput
# classifies the device correctly as a touchscreen and supplies its
# own coordinate transform.
Environment=QT_QPA_GENERIC_PLUGINS=libinput
# Show the software mouse cursor on the framebuffer (explicit; Qt's
# default is to show it but some Pi distros ship with it suppressed).
Environment=QT_QPA_FB_HIDECURSOR=0
Environment=HOME=/home/pimesh
Environment=PIMESH_GUI_EMBEDDED_UVICORN=0
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/python3 -m gui
Restart=always
RestartSec=5
# Cap memory: Pi has 1-4GB, 256M is generous for a Qt kiosk; catches leaks early.
MemoryMax=256M
OOMPolicy=kill
# Limit restart storms: max 5 restarts in 60s, then enter failed state.
StartLimitIntervalSec=60
StartLimitBurst=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
