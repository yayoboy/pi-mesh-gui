[Unit]
Description=pi-Mesh native Qt GUI (framebuffer kiosk)
After=network.target meshtasticd.service
Wants=meshtasticd.service
Conflicts=kiosk.service

[Service]
User=root
WorkingDirectory=/home/pimesh/pi-mesh-gui
Environment=QT_QPA_PLATFORM=linuxfb:fb=/dev/fb1
# Input plugins: dedicated evdevtouch for the ADS7846 SPI touchscreen so
# Qt receives proper QTouchEvent (and synthesizes mouse events from them),
# plus evdevmouse for the USB mouse and evdevkeyboard for the virtual kbd.
# Bind evdevtouch to the specific device node to skip the auto-scan that
# can latch onto the wrong device. _swapxy/_inverty land on the rotated
# 480x320 portrait orientation of the 3.5" panel.
Environment=QT_QPA_GENERIC_PLUGINS=evdevmouse,evdevkeyboard,evdevtouch:/dev/input/event2:rotate=90
# Show the software mouse cursor on the framebuffer (explicit; Qt's
# default is to show it but some Pi distros ship with it suppressed).
Environment=QT_QPA_FB_HIDECURSOR=0
Environment=HOME=/home/pimesh
Environment=PIMESH_GUI_EMBEDDED_UVICORN=0
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/python3 -m gui
Restart=always
RestartSec=5
# Cap memory: Pi has 1-4GB, 256M is generous for a Qt kiosk; catches leaks early.
MemoryMax=256M
OOMPolicy=kill
# Limit restart storms: max 5 restarts in 60s, then enter failed state.
StartLimitIntervalSec=60
StartLimitBurst=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
